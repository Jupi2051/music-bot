{
  "apps": [
    {
      "name": "GordoDJ",
      "script": "index.js",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production"
      },
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "exec_mode": "fork"
    }
  ]
}
