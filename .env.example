# Example .env file - Rename this file to .env and fill in your details

# Bot token obtained from the Discord Developer Portal
TOKEN=your_token_here

# Client ID (Application ID) of your Discord application
CLIENT_ID=your_client_id_here

# Optional: server ID for testing
# GUILD_ID=your_guild_id_here

# Optional: Spotify Developer credentials (https://developer.spotify.com/dashboard)
# Required to play full Spotify playlists and albums.
# Without them, Spotify works partially (individual tracks only).
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
