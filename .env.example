# Ejemplo de archivo .env - Renombra este archivo a .env y completa con tus datos

# Token de bot obtenido del Discord Developer Portal
TOKEN=tu_token_aqui

# ID de cliente (Application ID) de tu aplicación en Discord Developer Portal
CLIENT_ID=tu_client_id_aqui

# Opcional: ID de servidor para pruebas
# GUILD_ID=tu_guild_id_aqui
