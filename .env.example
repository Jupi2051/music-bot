# Example .env file - Rename this file to .env and fill in your details

# Bot token obtained from the Discord Developer Portal
TOKEN=your_token_here

# Client ID (Application ID) of your Discord application
CLIENT_ID=your_client_id_here

# Optional: server ID for testing
# GUILD_ID=your_guild_id_here

# Optional: prefix for text commands (e.g. "Chlplay"), case-insensitive.
# Requires the "Message Content Intent" enabled in the Discord Developer
# Portal (Bot section). Defaults to "Chl" if not set.
# PREFIX=Chl

# Optional: Spotify Developer credentials (https://developer.spotify.com/dashboard)
# Required to play full Spotify playlists and albums.
# Without them, Spotify works partially (individual tracks only).
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Optional: enables the cookie upload web UI (a form + tutorial for fixing
# YouTube's bot-check without touching the server) at this port. Unset by
# default — the bot won't listen on any port unless this is set. On Docker,
# `touch cookies.txt` on the host before the first `docker compose up` (see
# docker-compose.yml). See README for details.
# COOKIE_SERVER_PORT=8080

# Optional: fixes the access token for the cookie upload page above instead
# of a random one generated (and logged) on every restart. Keep it secret —
# anyone with it can overwrite the bot's YouTube cookies.
# COOKIE_SERVER_TOKEN=choose_a_long_random_string
